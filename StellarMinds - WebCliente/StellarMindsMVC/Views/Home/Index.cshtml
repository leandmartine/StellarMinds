@{
    ViewData["Title"] = "Home";
}

<div class="sm-welcome">
    <h1>Bienvenido a <span class="grad">StellarMinds</span></h1>
    <p>Sistema de gestión de equipos astronómicos, préstamos, observaciones y evaluación con IA.</p>
</div>

<div class="row g-3 justify-content-center">
    <div class="col-md-4">
        <div class="sm-card h-100 text-center">
            <h5 class="mb-2">Equipos</h5>
            <p class="text-muted mb-0 small">Telescopios, monturas, cámaras y oculares del observatorio.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="sm-card h-100 text-center">
            <h5 class="mb-2">Préstamos</h5>
            <p class="text-muted mb-0 small">Altas, devoluciones y seguimiento por socio o telescopio.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="sm-card h-100 text-center">
            <h5 class="mb-2">IA Gemini</h5>
            <p class="text-muted mb-0 small">Evaluá la adecuación del equipo para cada objeto celeste.</p>
        </div>
    </div>
</div>
