@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Inicio";
}

<div class="stars-layer" aria-hidden="true"></div>

<!-- ── Navbar ──────────────────────────────────────────────── -->
<nav class="landing-nav" id="landingNav" aria-label="Navegación principal">
    <div class="nav-inner">
        <a class="brand" href="#inicio">
            <span class="brand-orb" aria-hidden="true"></span>
            StellarMinds
        </a>

        <ul class="nav-links">
            <li><a href="#funciones">Funciones</a></li>
            <li><a href="#experiencia">Experiencia</a></li>
            <li><a href="#roles">Roles</a></li>
            <li><a href="#tecnologia">Tecnología</a></li>
            <li><a href="#proyecto">Proyecto</a></li>
            <li><a href="#repositorio">Repositorio</a></li>
        </ul>

        <div class="nav-actions">
            <a class="btn-sm-outline d-none d-sm-inline-flex"
               asp-controller="Usuario" asp-action="Login">
                Iniciar sesión
            </a>
            <a class="btn-sm-primary"
               asp-controller="Usuario" asp-action="Login">
                Entrar al sistema
            </a>
            <button type="button" class="nav-toggle" id="navToggle"
                    aria-label="Abrir menú" aria-expanded="false" aria-controls="mobileMenu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</nav>

<div class="mobile-menu" id="mobileMenu" role="navigation" aria-label="Menú móvil">
    <a href="#funciones">Funciones</a>
    <a href="#experiencia">Experiencia</a>
    <a href="#roles">Roles</a>
    <a href="#tecnologia">Tecnología</a>
    <a href="#proyecto">Proyecto</a>
    <a href="#repositorio">Repositorio</a>
    <a class="btn-sm-primary" asp-controller="Usuario" asp-action="Login">Iniciar sesión</a>
</div>

<!-- ── Hero ────────────────────────────────────────────────── -->
<header class="hero" id="inicio">
    <div class="hero-media" aria-hidden="true">
        <video autoplay muted loop playsinline poster="@Url.Content("~/img/landing/hero.jpg")">
            <source src="@Url.Content("~/videos/hero.mp4")" type="video/mp4"/>
        </video>
        <img src="@Url.Content("~/img/landing/hero.jpg")" alt="" class="d-none" id="heroFallback"/>
    </div>
    <div class="hero-overlay"></div>

    <div class="hero-content">
        <div class="hero-badge">
            <span class="dot"></span>
            Observatorio digital · ORT Uruguay
        </div>

        <h1>
            Gestioná el universo de tu
            <span class="gradient-text">observatorio</span>
        </h1>

        <p class="hero-lead">
            StellarMinds es la plataforma para administrar equipos astronómicos,
            préstamos, observaciones y evaluar con IA si tu instrumentación es
            adecuada para cada objeto celeste.
        </p>

        <div class="hero-cta">
            <a class="btn-sm-primary btn-lg" asp-controller="Usuario" asp-action="Login">
                Iniciar sesión
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
            <a class="btn-sm-outline btn-lg" href="#funciones">
                Descubrir funciones
            </a>
            <a class="btn-sm-ghost btn-lg" href="#repositorio">
                Ver repositorio
            </a>
        </div>

        <div class="hero-stats">
            <div class="stat-card">
                <strong><span data-count="3">0</span></strong>
                <span>Roles de usuario</span>
            </div>
            <div class="stat-card">
                <strong><span data-count="6">0</span>+</strong>
                <span>Módulos del sistema</span>
            </div>
            <div class="stat-card">
                <strong>IA</strong>
                <span>Evaluación con Gemini</span>
            </div>
        </div>
    </div>

    <a class="scroll-hint" href="#funciones" aria-label="Desplazarse a funciones">
        <span class="mouse"></span>
        Scroll
    </a>
</header>

<!-- ── Features ────────────────────────────────────────────── -->
<section class="section" id="funciones">
    <div class="section-inner">
        <div class="section-header reveal">
            <span class="section-kicker">Funciones</span>
            <h2>Todo lo que necesita un observatorio moderno</h2>
            <p>
                Desde el inventario de telescopios hasta el ranking de objetos celestes:
                una experiencia clara para administradores, coordinadores y socios.
            </p>
        </div>

        <div class="features-grid">
            <article class="feature-card reveal reveal-delay-1">
                <div class="card-media">
                    <img src="@Url.Content("~/img/landing/feature-1.jpg")" alt="Espacio profundo y nebulosas" loading="lazy"/>
                </div>
                <div class="card-body">
                    <div class="card-icon" aria-hidden="true">✦</div>
                    <h3>Objetos celestes y ranking</h3>
                    <p>
                        Consultá catálogos y el ranking de objetos más observados.
                        Ideal para planificar noches de observación.
                    </p>
                </div>
            </article>

            <article class="feature-card reveal reveal-delay-2">
                <div class="card-media">
                    <img src="@Url.Content("~/img/landing/feature-3.jpg")" alt="Telescopio profesional" loading="lazy"/>
                </div>
                <div class="card-body">
                    <div class="card-icon" aria-hidden="true">🔭</div>
                    <h3>Equipos y préstamos</h3>
                    <p>
                        Administrá telescopios, monturas, oculares y cámaras.
                        Registrá préstamos y devoluciones con trazabilidad completa.
                    </p>
                </div>
            </article>

            <article class="feature-card reveal reveal-delay-3">
                <div class="card-media">
                    <img src="@Url.Content("~/img/landing/feature-2.jpg")" alt="Panel de análisis astronómico con IA" loading="lazy"/>
                </div>
                <div class="card-body">
                    <div class="card-icon" aria-hidden="true">◈</div>
                    <h3>IA con Google Gemini</h3>
                    <p>
                        Evaluá automáticamente si el equipo es adecuado para el
                        objeto celeste observado y recibí un indicador de adecuación.
                    </p>
                </div>
            </article>
        </div>
    </div>
</section>

<!-- ── Showcase ─────────────────────────────────────────────── -->
<section class="section showcase" id="experiencia">
    <div class="section-inner">
        <div class="showcase-grid">
            <div class="showcase-video-wrap reveal">
                <div class="glow-ring" aria-hidden="true"></div>
                <video autoplay muted loop playsinline poster="@Url.Content("~/img/landing/feature-1.jpg")">
                    <source src="@Url.Content("~/videos/nebula.mp4")" type="video/mp4"/>
                </video>
            </div>

            <div class="showcase-copy reveal reveal-delay-2">
                <span class="section-kicker">Experiencia</span>
                <h2>Observaciones con inteligencia artificial</h2>
                <p>
                    Los socios registran observaciones vinculadas a equipos y objetos celestes.
                    StellarMinds integra la API de Google Gemini para sugerir qué tan adecuada
                    es la instrumentación para cada sesión.
                </p>
                <ul class="check-list">
                    <li>
                        <span class="check" aria-hidden="true">✓</span>
                        Alta de observaciones con tipo y detalles de la sesión
                    </li>
                    <li>
                        <span class="check" aria-hidden="true">✓</span>
                        Historial de préstamos por socio y por telescopio
                    </li>
                    <li>
                        <span class="check" aria-hidden="true">✓</span>
                        Auditoría de operaciones para el administrador
                    </li>
                    <li>
                        <span class="check" aria-hidden="true">✓</span>
                        Arquitectura en capas, API REST y autenticación JWT
                    </li>
                </ul>
                <a class="btn-sm-primary" asp-controller="Usuario" asp-action="Login">
                    Acceder ahora
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ── Roles ────────────────────────────────────────────────── -->
<section class="section" id="roles">
    <div class="section-inner">
        <div class="section-header reveal">
            <span class="section-kicker">Roles</span>
            <h2>Diseñado para cada perfil del observatorio</h2>
            <p>
                Permisos claros según tu rol. Iniciá sesión y el menú se adapta
                automáticamente a lo que podés hacer.
            </p>
        </div>

        <div class="roles-grid">
            <article class="role-card admin reveal reveal-delay-1">
                <span class="role-tag">Administrador</span>
                <h3>Control total</h3>
                <p>
                    Gestión de usuarios y equipos, auditoría de préstamos y
                    consultas globales del sistema.
                </p>
            </article>
            <article class="role-card coord reveal reveal-delay-2">
                <span class="role-tag">Coordinador</span>
                <h3>Operación diaria</h3>
                <p>
                    Alta de préstamos, devoluciones y seguimiento de socios
                    por telescopio.
                </p>
            </article>
            <article class="role-card socio reveal reveal-delay-3">
                <span class="role-tag">Socio</span>
                <h3>Observar y registrar</h3>
                <p>
                    Mis préstamos, nuevas observaciones y ranking de objetos
                    celestes.
                </p>
            </article>
        </div>
    </div>
</section>

<!-- ── Tech marquee ─────────────────────────────────────────── -->
<section class="tech-strip" id="tecnologia" aria-label="Tecnologías">
    <div class="tech-marquee" aria-hidden="true">
        <span>ASP.NET Core 10</span>
        <span>Entity Framework Core</span>
        <span>API REST + JWT</span>
        <span>Google Gemini</span>
        <span>SQL Server</span>
        <span>Arquitectura en capas</span>
        <span>SOLID</span>
        <span>Swagger / OpenAPI</span>
        <span>ASP.NET Core 10</span>
        <span>Entity Framework Core</span>
        <span>API REST + JWT</span>
        <span>Google Gemini</span>
        <span>SQL Server</span>
        <span>Arquitectura en capas</span>
        <span>SOLID</span>
        <span>Swagger / OpenAPI</span>
    </div>
</section>

<!-- ── Proyecto ─────────────────────────────────────────────── -->
<section class="section project-section" id="proyecto">
    <div class="section-inner">
        <div class="section-header reveal">
            <span class="section-kicker">Proyecto</span>
            <h2>Sobre StellarMinds</h2>
            <p>
                Proyecto final de la materia <strong>Desarrollo Web Asistido con IA</strong>
                (ORT Uruguay, 3er semestre). Sistema web para la gestión integral de un
                observatorio astronómico.
            </p>
        </div>

        <div class="project-grid">
            <article class="project-card reveal reveal-delay-1">
                <h3>Qué resuelve</h3>
                <p>
                    Centraliza usuarios, inventario de equipos (telescopios, monturas,
                    oculares y cámaras), préstamos, observaciones y evaluación de
                    adecuación equipo/objeto celeste mediante la API de Google Gemini.
                </p>
            </article>
            <article class="project-card reveal reveal-delay-2">
                <h3>Arquitectura</h3>
                <p>
                    Backend en capas con dominio, lógica de aplicación, acceso a datos
                    (EF Core), DTOs y API REST con JWT. Frontend MVC que consume la API.
                    Principios SOLID e inversión de dependencias.
                </p>
            </article>
            <article class="project-card reveal reveal-delay-3">
                <h3>Contenidos de la materia</h3>
                <ul class="project-list">
                    <li>CRUD completo sobre los módulos del sistema</li>
                    <li>Interfaces e inyección de dependencias</li>
                    <li>Integración con API Key de Gemini</li>
                    <li>Swagger / OpenAPI y despliegue en Somee</li>
                </ul>
            </article>
            <article class="project-card reveal reveal-delay-4">
                <h3>Autor y contexto</h3>
                <p>
                    Desarrollado por <strong>Leandro Martínez</strong> a lo largo del
                    primer semestre de 2026. Incluye script SQL, usuarios de prueba y
                    documentación de ejecución en el repositorio.
                </p>
            </article>
        </div>
    </div>
</section>

