<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="description" content="StellarMinds — Sistema de gestión de equipos astronómicos, préstamos, observaciones e IA con Gemini."/>
    <title>@ViewData["Title"] - StellarMinds</title>
    <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml" asp-append-version="true"/>
    <link rel="icon" href="~/favicon.ico" type="image/x-icon" asp-append-version="true"/>
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" asp-append-version="true"/>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true"/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet"/>
</head>
<body class="landing-body">
    @RenderBody()

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/landing.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
