@model StellarMindsMVC.Models.ErrorViewModel

@{
    ViewData["Title"] = "Error";
}

<div class="sm-page-header">
    <h1 class="text-danger">Error</h1>
    <p class="text-muted">Ocurrió un error al procesar la solicitud.</p>
</div>

<div class="sm-card">
    @if (Model.ShowRequestId)
    {
        <p class="mb-0"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
    else
    {
        <p class="mb-0 text-muted">Intentá nuevamente o volvé al inicio del sistema.</p>
    }
</div>
