@* RF11 - Auditoría de préstamos filtrable por coordinador. Solo Administrador.
   Modelo: AuditoriaViewModel con Auditorias (lista), Coordinadores (dropdown) y CoordinadorIdFiltro (seleccionado).
   El filtro se envía como GET con query param ?coordinadorId=X (el formulario usa method="get"). *@
@model StellarMindsMVC.Models.AuditoriaViewModel

@{
    ViewData["Title"] = "Auditoría de préstamos";
}

<div class="sm-page-header">
    <h1>Auditoría de préstamos</h1>
    <p class="text-muted">Historial de altas y devoluciones registradas por los coordinadores.</p>
</div>

@* Mensaje de error de la API si existe *@
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@* Formulario de filtro por coordinador — usa GET para que la URL quede con el filtro visible *@
<div class="sm-card">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-auto">
            <label for="coordinadorId" class="col-form-label fw-bold">Filtrar por coordinador:</label>
        </div>
        <div class="col-md-4">
            <select name="coordinadorId" id="coordinadorId" class="form-select">
                @* Opción vacía = sin filtro (muestra todas las auditorías) *@
                <option value="">— Todos los coordinadores —</option>
                @foreach (StellarMindsMVC.Models.UsuarioResumenModel coord in Model.Coordinadores)
                {
                    @* Mantiene la selección activa al volver a renderizar la vista *@
                    if (Model.CoordinadorIdFiltro == coord.Id)
                    {
                        <option value="@coord.Id" selected>@coord.NombreUsuario</option>
                    }
                    else
                    {
                        <option value="@coord.Id">@coord.NombreUsuario</option>
                    }
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Filtrar</button>
        </div>
        @if (Model.CoordinadorIdFiltro.HasValue)
        {
            @* Botón para limpiar el filtro y mostrar todas las auditorías *@
            <div class="col-auto">
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar filtro</a>
            </div>
        }
    </form>
</div>

@if (!Model.Auditorias.Any())
{
    <p class="text-muted">No hay registros de auditoría para mostrar.</p>
}
else
{
    <div class="sm-table-wrap">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Acción</th>
                    <th>Fecha</th>
                    <th>Coordinador</th>
                    <th>Préstamo #</th>
                    <th>Detalle</th>
                </tr>
            </thead>
            <tbody>
                @foreach (StellarMindsMVC.Models.AuditoriaModel item in Model.Auditorias)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>
                            @* Diferencia visualmente el alta del préstamo y la devolución *@
                            @if (item.Accion == StellarMindsMVC.Models.AccionAuditoria.ALTA_PRESTAMO)
                            {
                                <span class="badge bg-success">Alta préstamo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Devolución</span>
                            }
                        </td>
                        <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.CoordinadorNombre</td>
                        <td>@item.PrestamoId</td>
                        <td>
                            @* Link de detalle: abre la info completa del préstamo asociado (RF11) *@
                            <a asp-action="DetallePrestamo"
                               asp-route-prestamoId="@item.PrestamoId"
                               class="btn btn-sm btn-outline-primary">
                                Ver préstamo
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
