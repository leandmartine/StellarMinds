@* Listado de observaciones del socio autenticado.
   Modelo: IEnumerable<ObservacionModel> recibido desde ObservacionController.Index(). *@
@model IEnumerable<StellarMindsMVC.Models.ObservacionModel>

@{
    ViewData["Title"] = "Mis observaciones";
}

<h1>Mis observaciones</h1>
<p class="text-muted">Observaciones que registraste como socio.</p>

<a asp-action="Create" class="btn btn-primary mb-3">Nueva observación</a>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Aún no registraste observaciones.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Fecha</th>
                <th>Objeto celeste</th>
                <th>Tipo</th>
                <th>Indicador</th>
                <th>Detalle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (StellarMindsMVC.Models.ObservacionModel item in Model)
            {
                string badgeClass = item.Indicador switch
                {
                    StellarMindsMVC.Models.IndicadorAdecuacion.IDEAL    => "bg-success",
                    StellarMindsMVC.Models.IndicadorAdecuacion.ADECUADO => "bg-warning text-dark",
                    _                                                   => "bg-danger"
                };
                <tr>
                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@item.ObjetoNombre</td>
                    <td>@item.TipoObservacion</td>
                    <td><span class="badge @badgeClass">@item.Indicador</span></td>
                    <td>@item.Detalle</td>
                </tr>
            }
        </tbody>
    </table>
}
