@model IEnumerable<StellarMindsMVC.Models.UsuarioResumenModel>

@{
    ViewData["Title"] = "Usuarios";
}

<h1>Usuarios</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre de usuario</th>
            <th>Teléfono</th>
            <th>Rol</th>
        </tr>
    </thead>
    <tbody>
        @foreach (StellarMindsMVC.Models.UsuarioResumenModel item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.NombreUsuario</td>
                <td>@item.Telefono</td>
                <td>@item.Rol</td>
            </tr>
        }
    </tbody>
</table>
