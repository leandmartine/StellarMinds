@model IEnumerable<StellarMindsMVC.Models.EquipoModel>

@{
    ViewData["Title"] = "Equipos";
}

<div class="sm-page-header">
    <h1>Equipos</h1>
    <p class="text-muted">Inventario de instrumentación astronómica.</p>
</div>

<div class="sm-page-actions">
    <a asp-action="Create" class="btn btn-primary btn-sm">Nuevo equipo</a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="sm-table-wrap">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Tipo</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Stock</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (StellarMindsMVC.Models.EquipoModel item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td><span class="badge bg-primary">@item.TipoEquipo</span></td>
                    <td>@item.Marca</td>
                    <td>@item.Modelo</td>
                    <td>@item.Stock</td>
                    <td class="text-nowrap">
                        <a asp-action="Details" asp-route-id="@item.Id">Detalles</a>
                        <span class="text-muted mx-1">|</span>
                        <a asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                        <span class="text-muted mx-1">|</span>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
