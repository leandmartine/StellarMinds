@model StellarMindsMVC.Models.EquipoViewModel

@{
    ViewData["Title"] = "Nuevo equipo";
}

<div class="sm-page-header">
    <h1>Nuevo equipo</h1>
    <p class="text-muted">Registrá un telescopio, montura, cámara u ocular.</p>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="sm-card">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            <form asp-action="Create" method="post">
                @await Html.PartialAsync("_FormularioEquipo", Model)

                <div class="mt-3 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        (function () {
            var selector = document.getElementById('selectorTipo');
            if (!selector) return;
            var bloques = document.querySelectorAll('.bloque-tipo');

            function actualizar() {
                var tipo = selector.value;
                bloques.forEach(function (b) {
                    var visible = b.getAttribute('data-tipo') === tipo;
                    b.style.display = visible ? '' : 'none';
                    b.querySelectorAll('input, select').forEach(function (el) {
                        el.disabled = !visible;
                    });
                });
            }

            selector.addEventListener('change', actualizar);
            actualizar();
        })();
    </script>
}
