@model StellarMindsMVC.Models.PrestamoAltaViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Config

@{
    ViewData["Title"] = "Nuevo préstamo";
    string apiBase = Config["ApiBaseUrl"]?.TrimEnd('/') ?? "";
}

<div class="sm-page-header">
    <h1>Nuevo préstamo</h1>
    <p class="text-muted">Asigná equipos a un socio por un período determinado.</p>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="sm-card">
            <form asp-action="Create" method="post">

                <div class="mb-3">
                    <label asp-for="SocioId" class="form-label"></label>
                    <select asp-for="SocioId" asp-items="Model.Socios" class="form-select">
                        <option value="">-- Seleccione un socio --</option>
                    </select>
                    <span asp-validation-for="SocioId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TelescopioId" class="form-label"></label>
                    <select asp-for="TelescopioId" asp-items="Model.Telescopios" class="form-select" id="selectorTelescopio">
                        <option value="">-- Seleccione un telescopio --</option>
                    </select>
                    <span asp-validation-for="TelescopioId" class="text-danger"></span>
                    <small id="dispTelescopio" class="form-text"></small>
                </div>

                <div class="mb-3">
                    <label asp-for="MonturaId" class="form-label"></label>
                    <select asp-for="MonturaId" asp-items="Model.Monturas" class="form-select" id="selectorMontura">
                        <option value="">-- Seleccione una montura --</option>
                    </select>
                    <span asp-validation-for="MonturaId" class="text-danger"></span>
                    <small id="dispMontura" class="form-text"></small>
                </div>

                <div class="mb-3">
                    <label asp-for="CamaraId" class="form-label"></label>
                    <select asp-for="CamaraId" asp-items="Model.Camaras" class="form-select" id="selectorCamara">
                        <option value="">(sin cámara)</option>
                    </select>
                    <small id="dispCamara" class="form-text"></small>
                </div>

                <div class="mb-3">
                    <label asp-for="OcularId" class="form-label"></label>
                    <select asp-for="OcularId" asp-items="Model.Oculares" class="form-select" id="selectorOcular">
                        <option value="">(sin ocular)</option>
                    </select>
                    <small id="dispOcular" class="form-text"></small>
                </div>

                <div class="row">
                    <div class="col mb-3">
                        <label asp-for="FechaInicio" class="form-label"></label>
                        <input asp-for="FechaInicio" type="date" class="form-control" />
                        <span asp-validation-for="FechaInicio" class="text-danger"></span>
                    </div>
                    <div class="col mb-3">
                        <label asp-for="FechaFin" class="form-label"></label>
                        <input asp-for="FechaFin" type="date" class="form-control" />
                        <span asp-validation-for="FechaFin" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-2 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">Guardar préstamo</button>
                    <a asp-action="Devolucion" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        var apiBase = '@apiBase';

        function verificarDisponibilidad(selectId, badgeId) {
            var sel = document.getElementById(selectId);
            var badge = document.getElementById(badgeId);
            if (!sel || !badge) return;

            sel.addEventListener('change', function () {
                var id = sel.value;
                badge.textContent = '';
                if (!id) return;

                fetch(apiBase + '/api/Equipo/' + id + '/disponibilidad')
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data.disponible) {
                            badge.className = 'form-text text-success fw-bold';
                            badge.textContent = '✔ Disponible (stock: ' + data.stock + ')';
                        } else {
                            badge.className = 'form-text text-danger fw-bold';
                            badge.textContent = '✘ Sin stock disponible';
                        }
                    })
                    .catch(function () { badge.textContent = ''; });
            });
        }

        verificarDisponibilidad('selectorTelescopio', 'dispTelescopio');
        verificarDisponibilidad('selectorMontura',    'dispMontura');
        verificarDisponibilidad('selectorCamara',     'dispCamara');
        verificarDisponibilidad('selectorOcular',     'dispOcular');
    </script>
}
